@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .

### --- VERBETE: PLANTA ---

dbres:entry_planta a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2023-09-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:raissa_buss ;
    lexinfo:gender lexinfo:feminine ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm dbres:form_planta ;
    ontolex:otherForm dbres:form_plantas ;
    ontolex:sense dbres:entry_planta_sense1 .

dbres:etym_planta_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_planta_lat_sense1 ;
    dicbio:etymologicalArgumentation "Segundo o dicionário de Gaffiot, o substantivo latino *planta, ae* na Antiguidade tinha o sentido de “rebento” (ramo de uma planta extraído para propagação), mas também poderia ter o sentido mais geral de “vegetal”, sentido esse que passou ao português. A conservação do encontro consonantal pl- inicial aponta para a entrada na língua por via erudita, ainda que a palavra seja datada da Idade Média."@pt .

dbres:entry_planta_lat a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:raissa_buss ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:noun ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_planta_lat ;
    ontolex:sense dbres:entry_planta_lat_sense1 .

dbres:form_planta_lat a ontolex:Form ;
    ontolex:writtenRep "planta"@la .

dbres:entry_planta_lat_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_planta_lat_sense1_gaffiot .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_planta_lat_sense1_gaffiot a dicbio:Attestation ;
    dcterms:source dbsrc:source_gaffiot ;
    dicbio:attestationDate "-0055"^^xsd:gYear .

dbres:form_planta a ontolex:Form ;
    ontolex:writtenRep "planta"@pt .

dbres:form_plantas a ontolex:Form ;
    ontolex:writtenRep "plantas"@pt .

dbres:entry_planta_sense1 a ontolex:LexicalSense ;
    skos:definition "Designação comum a todos os vegetais."@pt ;
    lemonety:etymology dbres:etym_planta_sense1 .

