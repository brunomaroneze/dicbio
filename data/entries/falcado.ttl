### --- VERBETE: FALCADO ---

dbres:entry_falcado a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2023-09-15"^^xsd:date ;
    dcterms:creator dbauth:kamila_barbosa ;
    lexinfo:partOfSpeech lexinfo:adjective ;
    ontolex:canonicalForm dbres:form_falcado ;
    ontolex:otherForm dbres:form_falcada ;
    ontolex:sense dbres:entry_falcado_sense1 .

dbres:etym_falcado_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_falcatus_sense1 ;
    dicbio:etymologicalArgumentation "*Falcado* tem como étimo o latim *falcatus*, sendo caracterizado como um decalque advindo do latim. Apesar de ter uma base morfológica (substantivo *foice*, já atestada no séc. XIV), não podemos classificar *falcado* também como derivação, visto que, o que resultaria de *foice* quando anexado ao sufixo -*ado* seria uma forma diferente da que temos aqui representada - “*foiçado*” -, portanto,  é mais provável que Vandelli tenha recuperado a forma latina (*falcatus*) como base para a forma em língua portuguesa. Isto acontece porque o substantivo *foice* é uma palavra herdada e passou por diversas mudanças desde sua forma do latim *falx* para *foice*.  "@pt .

dbres:entry_falcatus a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:kamila_barbosa ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:adjective ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_falcatus ;
    ontolex:sense dbres:entry_falcatus_sense1 .

dbres:form_falcatus a ontolex:Form ;
    ontolex:writtenRep "falcatus"@la .

dbres:entry_falcatus_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_falcatus_sense1_diciovandelli .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_falcatus_sense1_diciovandelli a dicbio:Attestation ;
    dcterms:source dbsrc:work_diciovandelli ;
    dicbio:attestationDate "0001"^^xsd:gYear .
    # NOTA (datas): Coloquei como a data sendo de Tito Lívio
    # REVISAR (datas): o ano 1 não é o da fonte dbsrc:work_diciovandelli (1788); se a data vem de outra obra, a atestação precisa de outra fonte (ou crie uma segunda atestação)

dbres:form_falcado a ontolex:Form ;
    ontolex:writtenRep "falcado"@pt .

dbres:form_falcada a ontolex:Form ;
    lexinfo:number lexinfo:singular ;
    lexinfo:gender lexinfo:feminine ;
    ontolex:writtenRep "falcada"@pt .

dbres:entry_falcado_sense1 a ontolex:LexicalSense ;
    skos:definition "Que tem a forma de foice."@pt ;
    lemonety:etymology dbres:etym_falcado_sense1 .

