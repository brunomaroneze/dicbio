### --- VERBETE: BULBO ---
### Falta acertar a etimologia para cada acepção

dbres:entry_bulbo a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:gender lexinfo:masculine ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm dbres:form_bulbo ;
    ontolex:otherForm dbres:form_bulbos ;
    ontolex:sense dbres:entry_bulbo_sense1,
        dbres:entry_bulbo_sense2 .

dbres:etym_bulbo_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_bulbo_\(1\)_sense1,
        dbres:entry_bulbus_sense1 ;
        # Preciso entender por que há dois étimos aqui. Acho que são dois étimos encadeados. É preciso também incluir a ideia de que a segunda acepção é derivada da primeira.
    dicbio:etymologicalArgumentation "Conforme informa o Dicionário Houaiss, o étimo é o latim *bulbus,i*, que significa \"cebola, bulbo, tubérculo, raiz carnuda\", e é cognato do grego *bolbós,oû*, que significa \"cebola\". A forma latina já era empregada na Botânica no século XVIII, como atesta o dicionário de Vandelli. O Dicionário Houaiss também inclui o verbete *bolbo*, sem data, informando que seria a forma vulgar da palavra.<br>A atestação na \"Anatomia do corpo humano\" de Santucci antecede em algumas décadas a datação na Botânica, o que pode indicar que há uma datação ainda mais antiga na Botânica, ainda a ser encontrada.<br>No índice alfabético do dicionário de Vandelli, encontram-se as expressões latinas “Caulinus bulbus”, “Solitus bulbus”, “Squamatus bulbus” e “Tunicatus bulbus”, todas remetendo para o verbete de número 166; no entanto, esse verbete não existe, visto que o último é o de número 164. Assim, supõe-se que o autor previu a inclusão de um verbete para “bulbus”, mas não o incluiu."@pt .

dbres:entry_bulbo_\(1\)_sense1 a ontolex:LexicalSense ;
    dcterms:language "português" ;
    dcterms:source "nossa pesquisa" ;
    ontolex:writtenRep "bulbo (1)" .

dbres:entry_bulbus a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:noun ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_bulbus ;
    ontolex:sense dbres:entry_bulbus_sense1 .

dbres:form_bulbus a ontolex:Form ;
    ontolex:writtenRep "bulbus"@la .

dbres:entry_bulbus_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_bulbus_sense1 .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_bulbus_sense1 a dicbio:Attestation ;
    dcterms:source "Dicionário Houaiss" ;
    dicbio:attestationDate "-0160"^^xsd:gYear .
    # NOTA (datas): Já aparece com o sentido de "bulbo vegetal" especialmente cebola, em Catão.
    # REVISAR: fonte em texto livre (modelo antigo) — criar a fonte em sources.ttl
    #          (dbsrc:source_... ou dbsrc:work_...)

dbres:form_bulbo a ontolex:Form ;
    ontolex:writtenRep "bulbo"@pt .

dbres:form_bulbos a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    ontolex:writtenRep "bulbos"@pt .

dbres:entry_bulbo_sense1 a ontolex:LexicalSense ;
    skos:definition "Órgão vegetal presente em certas plantas, que armazena nutrientes para a planta utilizar em época desfavorável."@pt ;
    lemonety:etymology dbres:etym_bulbo_sense1 .

dbres:entry_bulbo_sense2 a ontolex:LexicalSense ;
    skos:definition "Estrutura anatômica semelhante a um bulbo (1), como o olho."@pt .

