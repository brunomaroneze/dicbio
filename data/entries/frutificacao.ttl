@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .

### --- VERBETE: FRUTIFICACAO ---

dbres:entry_frutificacao a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:gender lexinfo:feminine ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm dbres:form_frutificacao ;
    ontolex:otherForm dbres:form_fructificacao,
        dbres:form_fructificacoens,
        dbres:form_frutificacao,
        dbres:form_frutificacoens,
        dbres:form_frutificacoes ;
    ontolex:sense dbres:entry_frutificacao_sense1 .

dbres:etym_frutificacao_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_fructificatio_sense1 ;
    dicbio:etymologicalArgumentation "Conforme informa o Dicionário Houaiss, o étimo é o latim *fructificatio,onis*, com o sentido de \"ato de dar frutos\". A palavra já era empregada séculos antes da obra de Vandelli; aparentemente, o autor emprega essa palavra com o sentido de “conjunto de frutos”, ou talvez como um hiperônimo para tipos de fruto diversos. As formas variantes “frutificaçaõ”, “fructificaçaõ”, “fructificaçoens” (pl.) e “frutificações” (pl.) são todas empregadas na obra."@pt .

dbres:entry_fructificatio a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:noun ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_fructificatio ;
    ontolex:sense dbres:entry_fructificatio_sense1 .

dbres:form_fructificatio a ontolex:Form ;
    ontolex:writtenRep "fructificatio"@la .

dbres:entry_fructificatio_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_fructificatio_sense1 .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_fructificatio_sense1 a dicbio:Attestation ;
    dcterms:source "Dicionário Houaiss" ;
    dicbio:attestationDate "0200"^^xsd:gYear .
    # NOTA (datas): Gaffiot abona em Tertuliano
    # REVISAR: fonte em texto livre (modelo antigo) — criar a fonte em sources.ttl
    #          (dbsrc:source_... ou dbsrc:work_...)

dbres:form_frutificacao a ontolex:Form ;
    ontolex:writtenRep "Frutificaçaõ"@pt,
        "frutificaçaõ"@pt,
        "frutificação"@pt .

dbres:form_fructificacao a ontolex:Form ;
    ontolex:writtenRep "fructificaçaõ"@pt .

dbres:form_fructificacoens a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    ontolex:writtenRep "fructificaçoens"@pt .

dbres:form_frutificacoens a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    ontolex:writtenRep "frutificaçoens"@pt .

dbres:form_frutificacoes a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    ontolex:writtenRep "frutificações"@pt .

dbres:entry_frutificacao_sense1 a ontolex:LexicalSense ;
    skos:definition "Estrutura responsável pela reprodução vegetal, formada pelas flores e, posteriormente, pelos frutos."@pt ;
    lemonety:etymology dbres:etym_frutificacao_sense1 .

