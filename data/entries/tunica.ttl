@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .

### --- VERBETE: TUNICA ---

dbres:entry_tunica a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:gender lexinfo:feminine ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm dbres:form_tunica ;
    ontolex:otherForm dbres:form_tunica,
        dbres:form_tunicas ;
    ontolex:sense dbres:entry_tunica_sense1 .

dbres:etym_tunica_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_tunica_lat_sense1 ;
    dicbio:etymologicalArgumentation "Conforme informa o Dicionário Houaiss, o étimo é o latim *tunica,ae*, que já na Antiguidade significava \"vestimenta inferior usada pelos romanos de ambos os sexos\". A acepção da Botânica ocorre também no latim científico (como se observa, por exemplo, na obra “De radicum in plantis ortu et directione”, de Gottlob Bose, 1754, p. 7, disponível em https://books.google.pt/books?id=VK1JAAAAcAAJ)."@pt .

dbres:entry_tunica_lat a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:noun ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_tunica_lat ;
    ontolex:sense dbres:entry_tunica_lat_sense1 .

dbres:form_tunica_lat a ontolex:Form ;
    ontolex:writtenRep "tunica"@la .

dbres:entry_tunica_lat_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_tunica_lat_sense1 .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_tunica_lat_sense1 a dicbio:Attestation ;
    dcterms:source "“De radicum in plantis ortu et directione”, de Gottlob Bose, 1754, p. 7, disponível em https://books.google.pt/books?id=VK1JAAAAcAAJ" ;
    dicbio:attestationDate "1754"^^xsd:gYear .
    # NOTA (datas): A acepção da Antiguidade é diferente da científica.
    # REVISAR: fonte em texto livre (modelo antigo) — criar a fonte em sources.ttl
    #          (dbsrc:source_... ou dbsrc:work_...)

dbres:form_tunica a ontolex:Form ;
    ontolex:writtenRep "tunica"@pt,
        "túnica"@pt .

dbres:form_tunicas a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    ontolex:writtenRep "tunicas"@pt .

dbres:entry_tunica_sense1 a ontolex:LexicalSense ;
    skos:definition "Membrana que reveste certas estruturas vegetais, como raízes ou sementes, ou animais, como olhos."@pt ;
    lemonety:etymology dbres:etym_tunica_sense1 .

