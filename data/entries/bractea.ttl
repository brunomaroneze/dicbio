@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .


### --- VERBETE: BRACTEA ---

dbres:entry_bractea a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:gender lexinfo:feminine ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm dbres:form_bractea ;
    ontolex:otherForm dbres:form_bractea,
        dbres:form_bracteas ;
    ontolex:sense dbres:entry_bractea_sense1 .

dbres:etym_bractea_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_bractea_lat_sense1 ;
    dicbio:etymologicalArgumentation "O étimo é o latim científico *bractea*, já com o sentido usual da Botânica. No latim da Antiguidade, conforme informa o dicionário de Gaffiot, a palavra designava \"folha de metal, de ouro\"."@pt .

dbres:entry_bractea_lat a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:noun ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_bractea_lat ;
    ontolex:sense dbres:entry_bractea_lat_sense1 .

dbres:form_bractea_lat a ontolex:Form ;
    ontolex:writtenRep "bractea"@la .

dbres:entry_bractea_lat_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_bractea_lat_sense1_diciovandelli .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_bractea_lat_sense1_diciovandelli a dicbio:Attestation ;
    dcterms:source dbsrc:work_diciovandelli ;
    dicbio:attestationDate "1788"^^xsd:gYear .
    # NOTA (datas): A acepção da Antiguidade é outra, o étimo é do latim científico

dbres:form_bractea a ontolex:Form ;
    ontolex:writtenRep "bractea"@pt,
        "bractéa"@pt,
        "bráctea"@pt .

dbres:form_bracteas a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    ontolex:writtenRep "Bracteas"@pt,
        "Bractéas"@pt,
        "bracteas"@pt,
        "bractéas"@pt .

dbres:entry_bractea_sense1 a ontolex:LexicalSense ;
    skos:definition "Folha anexa à flor da florada seguinte, que se diferencia, em certos aspectos, das demais folhas."@pt ;
    lemonety:etymology dbres:etym_bractea_sense1 .

#------------------------------------------------------------