@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .


### --- VERBETE: BRACTEA ---

dbres:entry_bractea a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:gender lexinfo:feminine ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm dbres:form_bractea ;
    ontolex:otherForm dbres:form_bractea,
        dbres:form_bracteas ;
    ontolex:sense dbres:entry_bractea_sense1 .

dbres:etym_bractea_sense1 a lemonety:Etymology ;
    dcterms:source dbsrc:dicbio_project ;  # REVISAR (skill): argumentação própria do projeto; o Gaffiot só informa o sentido antigo
    dcterms:creator dbauth:bruno_maroneze ;
    dicbio:etymologicalProcess dicbio:borrowed ;  # REVISAR (skill): étimo no latim científico
    dicbio:confidenceLevel dicbio:probable ;  # REVISAR (skill): "O étimo é o latim científico bractea" afirmado sem ressalva, com atestação em Vandelli
    dicbio:semanticEtymon dbres:entry_bractea_lat_sense2 ;  # REVISAR (skill): aponta para a acepção científica (sense2); sense1 é a da Antiguidade
    dicbio:etymologicalArgumentation "O étimo é o latim científico *bractea*, já com o sentido usual da Botânica. No latim da Antiguidade, conforme informa o dicionário de Gaffiot, a palavra designava \"folha de metal, de ouro\"."@pt .

dbres:entry_bractea_lat a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:noun ;  # REVISAR (skill): L&S "bractĕa (also brattĕa), ae, f."
    lexinfo:gender lexinfo:feminine ;
    ontolex:canonicalForm dbres:form_bractea_lat ;
    ontolex:sense dbres:entry_bractea_lat_sense1,
        dbres:entry_bractea_lat_sense2 .

dbres:form_bractea_lat a ontolex:Form ;
    ontolex:writtenRep "bractea"@la .

# REVISAR (skill): a nota da planilha diz que a acepção da Antiguidade é outra; separei em duas acepções (uma por sentido)
dbres:entry_bractea_lat_sense1 a ontolex:LexicalSense ;
    skos:definition "Folha de metal, de ouro."@pt ;  # REVISAR (skill): glosa do Gaffiot dada na argumentação
    dicbio:hasAttestation dbres:attestation_bractea_lat_sense1_gaffiot .

dbres:attestation_bractea_lat_sense1_gaffiot a dicbio:Attestation ;
    dcterms:source dbsrc:source_gaffiot .
    # REVISAR (skill): falta o ano; o texto não diz qual autor o Gaffiot cita (o L&S traz Lucrécio e Virgílio)

dbres:entry_bractea_lat_sense2 a ontolex:LexicalSense ;
    skos:definition "Folha anexa à flor da florada seguinte, que se diferencia, em certos aspectos, das demais folhas."@pt ;  # REVISAR (skill): a argumentação diz "já com o sentido usual da Botânica"; repeti a definição da acepção portuguesa
    dicbio:hasAttestation dbres:attestation_bractea_lat_sense2_diciovandelli .

dbres:attestation_bractea_lat_sense2_diciovandelli a dicbio:Attestation ;
    dcterms:source dbsrc:work_diciovandelli ;
    dicbio:attestationDate "1788"^^xsd:gYear .

dbres:form_bractea a ontolex:Form ;
    ontolex:writtenRep "bractea"@pt,
        "bractéa"@pt,
        "bráctea"@pt .

dbres:form_bracteas a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    ontolex:writtenRep "Bracteas"@pt,
        "Bractéas"@pt,
        "bracteas"@pt,
        "bractéas"@pt .

dbres:entry_bractea_sense1 a ontolex:LexicalSense ;
    skos:definition "Folha anexa à flor da florada seguinte, que se diferencia, em certos aspectos, das demais folhas."@pt ;
    lemonety:etymology dbres:etym_bractea_sense1 .

#------------------------------------------------------------