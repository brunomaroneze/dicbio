### --- VERBETE: MEMBRANACEO ---

dbres:entry_membranaceo a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:partOfSpeech lexinfo:adjective ;
    ontolex:canonicalForm dbres:form_membranaceo ;
    ontolex:otherForm dbres:form_membranacea,
        dbres:form_membranaceas,
        dbres:form_membranaceo,
        dbres:form_membranaceos ;
    ontolex:sense dbres:entry_membranaceo_sense1 .

dbres:etym_membranaceo_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_membranaceus_sense1 ;
    dicbio:etymologicalArgumentation "Conforme informa o Dicionário Houaiss, o étimo é o latim *membranaceus,a,um*, que significa \"feito de uma membrana, formado de uma membrana; liso como uma membrana\", já empregado no latim científico, conforme atesta a obra de Vandelli. O sinônimo “membranoso” também ocorre em Vandelli, na parte reservada à Zoologia."@pt .

dbres:entry_membranaceus a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:adjective ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_membranaceus ;
    ontolex:sense dbres:entry_membranaceus_sense1 .

dbres:form_membranaceus a ontolex:Form ;
    ontolex:writtenRep "membranaceus"@la .

dbres:entry_membranaceus_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_membranaceus_sense1_diciovandelli .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_membranaceus_sense1_diciovandelli a dicbio:Attestation ;
    dcterms:source dbsrc:work_diciovandelli .
    # REVISAR: falta dicbio:attestationDate (recuperar a data na fonte)

dbres:form_membranaceo a ontolex:Form ;
    ontolex:writtenRep "Membranaceo"@pt,
        "membranaceo"@pt,
        "membranáceo"@pt .

dbres:form_membranacea a ontolex:Form ;
    lexinfo:number lexinfo:singular ;
    lexinfo:gender lexinfo:feminine ;
    ontolex:writtenRep "Membranacea"@pt,
        "membranacea"@pt .

dbres:form_membranaceas a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    lexinfo:gender lexinfo:feminine ;
    ontolex:writtenRep "Membranaceas"@pt,
        "membranaceas"@pt .

dbres:form_membranaceos a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    lexinfo:gender lexinfo:masculine ;
    ontolex:writtenRep "membranaceos"@pt .

dbres:entry_membranaceo_sense1 a ontolex:LexicalSense ;
    skos:definition "Delgado, comprido, em formato de lâmina ou membrana."@pt ;
    lemonety:etymology dbres:etym_membranaceo_sense1 .

