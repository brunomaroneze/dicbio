@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .

### --- VERBETE: CRENA ---

dbres:entry_crena a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:gender lexinfo:feminine ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm dbres:form_crena ;
    ontolex:otherForm dbres:form_crenas ;
    ontolex:sense dbres:entry_crena_sense1 .

dbres:etym_crena_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_crena_lat_sense1 ;
    dicbio:etymologicalArgumentation "O étimo é o latim científico *crena,ae*, com o mesmo significado, conforme se observa na própria obra de Vandelli. O Dicionário Houaiss afirma que a palavra era empregada no latim tardio com o sentido de “entalhe, fenda”."@pt .

dbres:entry_crena_lat a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:noun ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_crena_lat ;
    ontolex:sense dbres:entry_crena_lat_sense1 .

dbres:form_crena_lat a ontolex:Form ;
    ontolex:writtenRep "crena"@la .

dbres:entry_crena_lat_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_crena_lat_sense1_diciovandelli .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_crena_lat_sense1_diciovandelli a dicbio:Attestation ;
    dcterms:source dbsrc:work_diciovandelli ;
    dicbio:attestationDate "1788"^^xsd:gYear .
    # NOTA (datas): Parte latina de Vandelli

dbres:form_crena a ontolex:Form ;
    ontolex:writtenRep "crena"@pt .

dbres:form_crenas a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    ontolex:writtenRep "crenas"@pt .

dbres:entry_crena_sense1 a ontolex:LexicalSense ;
    skos:definition "Incisura perpendicular obtusa na margem de certas folhas."@pt ;
    lemonety:etymology dbres:etym_crena_sense1 ;
    dicbio:semanticEtymology dbres:sem_etym_crena_sense1 .

