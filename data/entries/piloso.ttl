@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .

### --- VERBETE: PILOSO ---

dbres:entry_piloso a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:partOfSpeech lexinfo:adjective ;
    ontolex:canonicalForm dbres:form_piloso ;
    ontolex:otherForm dbres:form_pillosa,
        dbres:form_pilosas ;
    ontolex:sense dbres:entry_piloso_sense1 .

dbres:etym_piloso_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_pilosus_sense1 ;
    dicbio:etymologicalArgumentation "O étimo é o latim científico *pilosus,a,um*, com o mesmo sentido, conforme atesta o próprio dicionário de Vandelli. A palavra latina já era usada na Antiguidade com o sentido de “peludo, coberto de pelos” (conforme se lê no dicionário de Gaffiot), mas o termo português é claramente um empréstimo do latim científico, e não uma palavra herdada."@pt .

dbres:entry_pilosus a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:adjective ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_pilosus ;
    ontolex:sense dbres:entry_pilosus_sense1 .

dbres:form_pilosus a ontolex:Form ;
    ontolex:writtenRep "pilosus"@la .

dbres:entry_pilosus_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_pilosus_sense1_diciovandelli .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_pilosus_sense1_diciovandelli a dicbio:Attestation ;
    dcterms:source dbsrc:work_diciovandelli .
    # REVISAR: falta dicbio:attestationDate (recuperar a data na fonte)

dbres:form_piloso a ontolex:Form ;
    ontolex:writtenRep "piloso"@pt .

dbres:form_pillosa a ontolex:Form ;
    lexinfo:number lexinfo:singular ;
    lexinfo:gender lexinfo:feminine ;
    ontolex:writtenRep "pillosa"@pt .

dbres:form_pilosas a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    lexinfo:gender lexinfo:feminine ;
    ontolex:writtenRep "pilosas"@pt .

dbres:entry_piloso_sense1 a ontolex:LexicalSense ;
    skos:definition "Coberto de estruturas semelhantes a pelos (diz-se de folha)."@pt ;
    lemonety:etymology dbres:etym_piloso_sense1 .

