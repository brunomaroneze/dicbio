### --- VERBETE: GELATINOSO ---

dbres:entry_gelatinoso a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2025-04-22"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:fabiani_goncalves ;
    lexinfo:partOfSpeech lexinfo:adjective ;
    ontolex:canonicalForm dbres:form_gelatinoso ;
    ontolex:otherForm dbres:form_jalatinosa ;
    ontolex:sense dbres:entry_gelatinoso_sense1 .

dbres:etym_gelatinoso_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_gelatinosus_sense1 ;
    dicbio:etymologicalArgumentation "Em relação à identificação do étimo deste termo, os dados são conflitantes. A ocorrência da expressão latina *tumor gelatinosus* num texto de 1695 (\"Index... Rerum Memorabilium & Notabilium...\" - https://www.google.com.br/books/edition/Miscellanea_Curiosa_medico_physica_acade/gH5EAAAAcAAJ) parece apontar para uma criação do latim científico (visto que o termo não está registrado nos dicionários do latim da Antiguidade) que teria passado ao português; portanto, um latinismo. No entanto, a forma atestada em Santucci é \"jalatinosa\", e não a forma esperada \"gelatinosa\", o que aponta para uma pronúncia popular e uma possível derivação sufixal inteiramente vernácula. Será necessário buscar outras atestações do termo e, possivelmente, de uma forma primitiva *\"jalatina\". Não obstante, a forma atual \"gelatinoso\" foi muito provavelmente influenciada pela forma latina."@pt .

dbres:entry_gelatinosus a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:fabiani_goncalves ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:adjective ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_gelatinosus ;
    ontolex:sense dbres:entry_gelatinosus_sense1 .

dbres:form_gelatinosus a ontolex:Form ;
    ontolex:writtenRep "gelatinosus"@la .

dbres:entry_gelatinosus_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_gelatinosus_sense1 .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_gelatinosus_sense1 a dicbio:Attestation ;
    dcterms:source "\"Index... Rerum Memorabilium & Notabilium...\" - https://www.google.com.br/books/edition/Miscellanea_Curiosa_medico_physica_acade/gH5EAAAAcAAJ" .
    # REVISAR: fonte em texto livre (modelo antigo) — criar a fonte em sources.ttl
    #          (dbsrc:source_... ou dbsrc:work_...) e acrescentar dicbio:attestationDate

dbres:form_gelatinoso a ontolex:Form ;
    ontolex:writtenRep "gelatinoso"@pt .

dbres:form_jalatinosa a ontolex:Form ;
    lexinfo:number lexinfo:singular ;
    lexinfo:gender lexinfo:feminine ;
    ontolex:writtenRep "jalatinosa"@pt .

dbres:entry_gelatinoso_sense1 a ontolex:LexicalSense ;
    skos:definition "Que tem consistência de gelatina."@pt ;
    lemonety:etymology dbres:etym_gelatinoso_sense1 .

