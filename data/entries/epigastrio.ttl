### --- VERBETE: EPIGASTRIO ---

dbres:entry_epigastrio a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-07-25"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:raissa_buss ;
    lexinfo:gender lexinfo:masculine ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm dbres:form_epigastrio ;
    ontolex:otherForm dbres:form_epigastrio ;
    ontolex:sense dbres:entry_epigastrio_sense1 .

dbres:etym_epigastrio_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_epigastrium_sense1 ;
    dicbio:etymologicalArgumentation "O étimo é o latim científico *Epigastrium*, atestado já no século XVI (por exemplo, em “A dictionary in Latine and English”, de John Veron, 1575 - https://www.google.com.br/books/edition/A_Dictionary_in_Latine_and_English_corre/H85lAAAAcAAJ). Por não estar registrado nem no Oxford Latin Dictionary nem no dicionário de Gaffiot, supõe-se que não era empregado em latim na Antiguidade; mas o dicionário LSJ registra a forma *epigástrion*) (ἐπιγάστριον), ora com o sentido de “abdômen”, ora com o sentido de “parte do abdômen acima do umbigo”. Assim, a forma latina, provavelmente medieval ou renascentista, foi cunhada a partir do grego."@pt .

dbres:entry_epigastrium a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:raissa_buss ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:noun ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_epigastrium ;
    ontolex:sense dbres:entry_epigastrium_sense1 .

dbres:form_epigastrium a ontolex:Form ;
    ontolex:writtenRep "epigastrium"@la .

dbres:entry_epigastrium_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_epigastrium_sense1 .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_epigastrium_sense1 a dicbio:Attestation ;
    dcterms:source "“A dictionary in Latine and English”, de John Veron, 1575 - https://www.google.com.br/books/edition/A_Dictionary_in_Latine_and_English_corre/H85lAAAAcAAJ" .
    # REVISAR: fonte em texto livre (modelo antigo) — criar a fonte em sources.ttl
    #          (dbsrc:source_... ou dbsrc:work_...) e acrescentar dicbio:attestationDate

dbres:form_epigastrio a ontolex:Form ;
    ontolex:writtenRep "Epigastrio"@pt,
        "epigastrio"@pt,
        "epigástrio"@pt .

dbres:entry_epigastrio_sense1 a ontolex:LexicalSense ;
    skos:definition "Região do abdômen situada abaixo do diafragma, terminando um pouco acima do umbigo."@pt ;
    lemonety:etymology dbres:etym_epigastrio_sense1 .

