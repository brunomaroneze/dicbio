@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .

### --- VERBETE: EMARGINADO ---

dbres:entry_emarginado a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2023-09-25"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:kamila_barbosa ;
    lexinfo:partOfSpeech lexinfo:adjective ;
    ontolex:canonicalForm dbres:form_emarginado ;
    ontolex:otherForm dbres:form_emarginados ;
    ontolex:sense dbres:entry_emarginado_sense1 .

dbres:etym_emarginado_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_emarginatus_sense1 ;
    dicbio:etymologicalArgumentation "O étimo é o latim *emarginatus*, particípio do verbo *ēmargĭnō, āre* (atestado desde a Antiguidade, com o sentido de \"corroer as margens\", conforme registrado no Oxford Latin Dictionary), caracterizando-se como um decalque do latim. O termo ingressou na língua portuguesa certamente pela via erudita, por meio do latim científico, visto que *emarginatus* é empregado no próprio dicionário de Vandelli."@pt .

dbres:entry_emarginatus a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:kamila_barbosa ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:adjective ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_emarginatus ;
    ontolex:sense dbres:entry_emarginatus_sense1 .

dbres:form_emarginatus a ontolex:Form ;
    ontolex:writtenRep "emarginatus"@la .

dbres:entry_emarginatus_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_emarginatus_sense1_old .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_emarginatus_sense1_old a dicbio:Attestation ;
    dcterms:source dbsrc:source_old ;
    dicbio:attestationDate "0077"^^xsd:gYear .
    # NOTA (datas): É o particípio do verbo "emargino, emarginare", atestado em Plínio, segundo Gaffiot

dbres:form_emarginado a ontolex:Form ;
    ontolex:writtenRep "emarginado"@pt .

dbres:form_emarginados a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    lexinfo:gender lexinfo:masculine ;
    ontolex:writtenRep "emarginados"@pt .

dbres:entry_emarginado_sense1 a ontolex:LexicalSense ;
    skos:definition "Que apresenta recorte (em sua maioria) curvo na ponta (diz-se de folha)."@pt ;
    lemonety:etymology dbres:etym_emarginado_sense1 .

