### --- VERBETE: DEFLEXO ---

dbres:entry_deflexo a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:partOfSpeech lexinfo:adjective ;
    ontolex:canonicalForm dbres:form_deflexo ;
    ontolex:otherForm dbres:form_deflexos ;
    ontolex:sense dbres:entry_deflexo_sense1 .

dbres:etym_deflexo_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_deflexus_sense1 ;
    dicbio:etymologicalArgumentation "Conforme explica o Dicionário Houaiss, o étimo é o adjetivo latino *deflexus,a,um*, que significa \"voltado para dentro\", particípio passado do verbo *deflectere*. O seu emprego no latim científico é atestado na própria obra de Vandelli, o que evidencia que se trata de um empréstimo, e não de palavra herdada."@pt .

dbres:entry_deflexus a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:adjective ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_deflexus ;
    ontolex:sense dbres:entry_deflexus_sense1 .

dbres:form_deflexus a ontolex:Form ;
    ontolex:writtenRep "deflexus"@la .

dbres:entry_deflexus_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_deflexus_sense1 .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_deflexus_sense1 a dicbio:Attestation ;
    dcterms:source "Dicionário Houaiss" ;
    dicbio:attestationDate "1788"^^xsd:gYear .
    # NOTA (datas): Parte latina de Vandelli
    # REVISAR: fonte em texto livre (modelo antigo) — criar a fonte em sources.ttl
    #          (dbsrc:source_... ou dbsrc:work_...)

dbres:form_deflexo a ontolex:Form ;
    ontolex:writtenRep "deflexo"@pt .

dbres:form_deflexos a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    ontolex:writtenRep "deflexos"@pt .

dbres:entry_deflexo_sense1 a ontolex:LexicalSense ;
    skos:definition "Encurvado para a parte inferior (diz-se de ramo)."@pt ;
    lemonety:etymology dbres:etym_deflexo_sense1 .

