@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .

### --- VERBETE: ESTIPULA ---

dbres:entry_estipula a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:gender lexinfo:feminine ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm dbres:form_estipula ;
    ontolex:otherForm dbres:form_estipulas ;
    ontolex:sense dbres:entry_estipula_sense1 .

dbres:etym_estipula_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_stipula_sense1 ;
    dicbio:etymologicalArgumentation "O étimo é o latim *stipula*, cujo sentido original de \"haste dos cereais\" remonta à Antiguidade; no entanto, o seu emprego científico como termo da Botânica deriva do latim científico (como atesta a própria obra de Vandelli), sendo, portanto, empréstimo do latim."@pt .

dbres:entry_stipula a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:noun ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_stipula ;
    ontolex:sense dbres:entry_stipula_sense1 .

dbres:form_stipula a ontolex:Form ;
    ontolex:writtenRep "stipula"@la .

dbres:entry_stipula_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_stipula_sense1_diciovandelli .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_stipula_sense1_diciovandelli a dicbio:Attestation ;
    dcterms:source dbsrc:work_diciovandelli ;
    dicbio:attestationDate "-0160"^^xsd:gYear .
    # REVISAR (datas): o ano -160 não é o da fonte dbsrc:work_diciovandelli (1788); se a data vem de outra obra, a atestação precisa de outra fonte (ou crie uma segunda atestação)

dbres:form_estipula a ontolex:Form ;
    ontolex:writtenRep "estípula"@pt .

dbres:form_estipulas a ontolex:Form ;
    lexinfo:number lexinfo:plural ;
    ontolex:writtenRep "estipulas"@pt .

dbres:entry_estipula_sense1 a ontolex:LexicalSense ;
    skos:definition "Escama que nasce na base do pecíolo ou do pedúnculo."@pt ;
    lemonety:etymology dbres:etym_estipula_sense1 .

