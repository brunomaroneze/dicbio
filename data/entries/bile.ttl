@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix vartrans: <http://www.w3.org/ns/lemon/vartrans#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .


### --- VERBETE: BILE ---

dbres:entry_bile a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2024-05-07"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:fabiani_goncalves ;
    lexinfo:gender lexinfo:feminine ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm dbres:form_bile ;
    ontolex:sense dbres:entry_bile_sense1 .

dbres:etym_bile_sense1 a lemonety:Etymology ;
    dcterms:source dbsrc:dicbio_project ;  # REVISAR (skill): argumentação própria do projeto; o OLD só atesta o étimo
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:fabiani_goncalves ;
    dicbio:etymologicalProcess dicbio:borrowed ;  # REVISAR (skill): "palavra erudita, que certamente entrou na língua por meio do latim científico"
    dicbio:confidenceLevel dicbio:certain ;  # REVISAR (skill): étimo afirmado sem ressalva, com apoio fonético (-l- intervocálico) e "certamente"; se o "certamente" valer só para a via erudita, baixar para probable (como em caule)
    dicbio:semanticEtymon dbres:entry_bilis_sense1 ;
    dicbio:etymologicalArgumentation "O étimo é o latim *bilis*, já atestado desde a Antiguidade com o sentido de \"fluido secretado pelo fígado\" (conforme mostra o Oxford Latin Dictionary). A conservação do -l- intervocálico e a data tardia de registro na língua portuguesa indicam tratar-se de palavra erudita, que certamente entrou na língua por meio do latim científico."@pt .

dbres:entry_bilis a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze,
        dbauth:fabiani_goncalves ;
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:noun ;  # REVISAR (skill): L&S "bīlis, is", feminino
    lexinfo:gender lexinfo:feminine ;
    ontolex:canonicalForm dbres:form_bilis ;
    ontolex:sense dbres:entry_bilis_sense1 .

dbres:form_bilis a ontolex:Form ;
    ontolex:writtenRep "bilis"@la .

dbres:entry_bilis_sense1 a ontolex:LexicalSense ;
    skos:definition "Fluido secretado pelo fígado."@pt ;  # REVISAR (skill): glosa dada na argumentação
    dicbio:hasAttestation dbres:attestation_bilis_sense1_old .

dbres:attestation_bilis_sense1_old a dicbio:Attestation ;
    dcterms:source dbsrc:source_old ;
    skos:note "O Oxford Latin Dictionary abona o termo em Plauto, Cícero, Catão e outros autores."@pt ;
    dicbio:attestationDate "-0200"^^xsd:gYear .
    # REVISAR (skill): a argumentação diz que a palavra entrou pelo latim científico, mas não dá a obra; falta a atestação do latim científico

dbres:form_bile a ontolex:Form ;
    ontolex:writtenRep "bile"@pt .

dbres:entry_bile_sense1 a ontolex:LexicalSense ;
    skos:definition "Substância secretada pelo fígado que atua na digestão."@pt ;
    lemonety:etymology dbres:etym_bile_sense1 .

#------------------------------------------------------------