@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dicbio: <https://dicbio.fflch.usp.br/ontology/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lemonety: <http://lari-datasets.ilc.cnr.it/lemonEty#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dbauth: <https://dicbio.fflch.usp.br/autores/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix dbres: <https://dicbio.fflch.usp.br/recurso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
@prefix glotto: <https://glottolog.org/resource/languoid/id/> .
@prefix dbsrc: <https://dicbio.fflch.usp.br/fontes/> .

### --- VERBETE: PARASITICO ---

dbres:entry_parasitico a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:partOfSpeech lexinfo:adjective ;
    ontolex:canonicalForm dbres:form_parasitico ;
    ontolex:otherForm dbres:form_parasitica ;
    ontolex:sense dbres:entry_parasitico_sense1 .

dbres:etym_parasitico_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_parasiticus_sense1 ;
    dicbio:etymologicalArgumentation "O Dicionário Houaiss propõe que o termo é uma derivação sufixal (*parasita* + *-ico*). Como o dicionário de Vandelli não registra uma forma latina equivalente, não há evidência de que tenha sido um decalque do latim científico.Tanto Vandelli quanto Moraes Silva registram a expressão *planta parasitica*, o que leva a crer que o adjetivo pode ter tido o seu primeiro emprego como parte dessa expressão, e apenas depois tem seu emprego estendido para outros tipos de parasitas."@pt .

dbres:entry_parasiticus a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:adjective ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_parasiticus ;
    ontolex:sense dbres:entry_parasiticus_sense1 .

dbres:form_parasiticus a ontolex:Form ;
    ontolex:writtenRep "parasiticus"@la .

dbres:entry_parasiticus_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_parasiticus_sense1_gaffiot .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_parasiticus_sense1_gaffiot a dicbio:Attestation ;
    dcterms:source dbsrc:source_gaffiot .
    # REVISAR: falta dicbio:attestationDate (recuperar a data na fonte)

dbres:form_parasitico a ontolex:Form ;
    ontolex:writtenRep "parasítico"@pt .

dbres:form_parasitica a ontolex:Form ;
    lexinfo:number lexinfo:singular ;
    lexinfo:gender lexinfo:feminine ;
    ontolex:writtenRep "parasitica"@pt .

dbres:entry_parasitico_sense1 a ontolex:LexicalSense ;
    skos:definition "Que está preso a outra planta, e não diretamente à terra (diz-se de planta)."@pt ;
    lemonety:etymology dbres:etym_parasitico_sense1 .

