### --- VERBETE: COARCTADO ---

dbres:entry_coarctado a ontolex:LexicalEntry ;
    dcterms:language glotto:port1283 ;
    dcterms:created "2022-02-28"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;
    lexinfo:partOfSpeech lexinfo:adjective ;
    ontolex:canonicalForm dbres:form_coarctado ;
    ontolex:sense dbres:entry_coarctado_sense1 .

dbres:etym_coarctado_sense1 a lemonety:Etymology ;
    dicbio:semanticEtymon dbres:entry_coarctatus_sense1 ;
    dicbio:etymologicalArgumentation "Conforme informa o Dicionário Houaiss, o étimo é o latim *coarctatus,a,um*, particípio passado de *coarctare*, que significa \"apertar, estreitar\". Já era empregado na acepção da Botânica no latim do século XVIII, conforme atestado na própria obra de Vandelli. O Dicionário Houaiss não inclui nenhuma rubrica referente à Botânica; a datação informada é possivelmente para outra acepção."@pt .

dbres:entry_coarctatus a ontolex:LexicalEntry ;
    dcterms:created "2026-11-15"^^xsd:date ;
    dcterms:creator dbauth:bruno_maroneze ;  # REVISAR: criadores copiados da entrada principal
    dcterms:language glotto:lati1261 ;
    lexinfo:partOfSpeech lexinfo:adjective ;  # REVISAR: classe copiada da entrada principal
    ontolex:canonicalForm dbres:form_coarctatus ;
    ontolex:sense dbres:entry_coarctatus_sense1 .

dbres:form_coarctatus a ontolex:Form ;
    ontolex:writtenRep "coarctatus"@la .

dbres:entry_coarctatus_sense1 a ontolex:LexicalSense ;
    dicbio:hasAttestation dbres:attestation_coarctatus_sense1_diciovandelli .
    # REVISAR: falta skos:definition (sentido do étimo; ver a argumentação)

dbres:attestation_coarctatus_sense1_diciovandelli a dicbio:Attestation ;
    dcterms:source dbsrc:work_diciovandelli .
    # REVISAR: falta dicbio:attestationDate (recuperar a data na fonte)

dbres:form_coarctado a ontolex:Form ;
    ontolex:writtenRep "coarctado"@pt .

dbres:entry_coarctado_sense1 a ontolex:LexicalSense ;
    skos:definition "Apertado, restringido; cujas estruturas são muito próximas entre si."@pt ;
    lemonety:etymology dbres:etym_coarctado_sense1 .

